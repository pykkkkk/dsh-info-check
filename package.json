{
  "name": "dsh-info-check",
  "version": "0.3.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "description": "DSH engineering-contract workflow: task book, CNY budget sign-off, per-milestone acceptance and budget review, delivery, and settlement.",
  "license": "MIT",
  "author": "pykkkkk (Wenhao Liu)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pykkkkk/dsh-info-check.git"
  },
  "homepage": "https://github.com/pykkkkk/dsh-info-check#readme",
  "bugs": {
    "url": "https://github.com/pykkkkk/dsh-info-check/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "confirmation",
    "guardrails",
    "human-in-the-loop"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "selfcheck": "node scripts/self-check.mjs",
    "minimal-test": "node scripts/minimal-test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "scripts",
    "README.md",
    "README.en.md",
    "screenshots.json",
    "LICENSE",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
