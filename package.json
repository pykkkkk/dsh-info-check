{
  "name": "dsh-info-check",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "description": "DSH confirmation gate: intent check, one plan confirmation, per-milestone acceptance, delivery sign-off, and a workspace ledger.",
  "license": "MIT",
  "author": "pykkkkk (Wenhao Liu)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pykkkkk/dsh-info-check.git"
  },
  "homepage": "https://github.com/pykkkkk/dsh-info-check#readme",
  "bugs": {
    "url": "https://github.com/pykkkkk/dsh-info-check/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "confirmation",
    "guardrails",
    "human-in-the-loop"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/index.js && node --check lib/pure.js && node --check lib/selfcheck.js && node --check lib/retrospective.js && node --check lib/retrospective-store.js",
    "test": "node test/pure.test.mjs && node test/retrospective.test.mjs && node test/client.smoke.mjs && node scripts/self-check.mjs",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File test/e2e/run.ps1",
    "selfcheck": "node scripts/self-check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
